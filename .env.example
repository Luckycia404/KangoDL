KANGODL_STORAGE=/app/storage
KANGODL_MAX_UPLOAD_BYTES=524288000
KANGODL_MAX_DOWNLOAD_BYTES=2147483648
KANGODL_API_KEY=replace-with-a-long-random-secret
KANGODL_REQUIRE_API_KEY=1
PORT=8000

# Reddit public Data API OAuth app credentials (required on hosted VPS)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=KangoDL/0.8.0 (public media extractor)

# Optional authenticated YouTube session (Netscape/Mozilla cookie export)
KANGODL_YOUTUBE_COOKIE_FILE=/app/storage/auth/youtube.cookies

# Optional official platform credentials
PINTEREST_ACCESS_TOKEN=
AUDIOMACK_CONSUMER_KEY=
AUDIOMACK_CONSUMER_SECRET=
