[Unit]
Description=KangoDL Engine API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kangodl-engine
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/kangodl-engine/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8877
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/kangodl-engine/storage

[Install]
WantedBy=multi-user.target
